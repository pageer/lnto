# Connection settings for push-assets.ps1.
# Copy this file to .env and fill in your values. .env is gitignored.

# SSH account on the shared host
REMOTE_USER=myuser
REMOTE_HOST=myhost.example.com
REMOTE_PORT=22

# Absolute path to the lnto deployment directory on the host
REMOTE_PATH=/home/myuser/www/lnto
